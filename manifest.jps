type: install
version: 0.2.0
id: constructor-fabric
baseUrl: https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/main/
name: Constructor Fabric
logo: assets/constructor-fabric-logo.png
categories:
  - apps/dev-and-admin-tools
  - apps/collaboration
  - apps/productivity

description:
  text: CLets AI define, build, and run software end to end -- with reusable components, operational automation, and built-in productivity measurement and insights.
  short: Constructor Fabric

targetRegions:
  type: vz7

ssl: true
skipNodeEmails: true

globals:
  VNC_PASSWORD: ${fn.password(16)}
  CF_PORT: 8081
  APP_PORT: 8081
  LLM_PROVIDER: openai
  OPENAI_MODEL: gpt-5.5
  CLAUDE_MODEL: claude-3-5-sonnet-latest
  RESOLUTION: 1280x720
  SCRIPT_VERSION: trainer-icons-20260602-1
  CF_SOURCE_REF: 8631e117e56cc13e8bc427101a320667c0a3a7e3

settings:
  fields:
    - caption: LLM provider
      type: list
      inputType: string
      name: llm-provider
      default: openai
      values:
        openai: OpenAI
        claude: Claude
      tooltip: Select which LLM provider the Constructor Fabric workflow should use.
      showIf:
        openai:
          - caption: OpenAI model
            type: list
            inputType: string
            name: openai-model
            default: gpt-5.5
            values:
              gpt-5.5: OpenAI GPT-5.5
              gpt-5.4: OpenAI GPT-5.4
              gpt-5.4-mini: OpenAI GPT-5.4 mini
              gpt-5.4-nano: OpenAI GPT-5.4 nano
            tooltip: Select the OpenAI model used by the Constructor Fabric workflow.
        claude:
          - caption: Anthropic model
            type: list
            inputType: string
            name: claude-model
            default: claude-3-5-sonnet-latest
            values:
              claude-3-5-sonnet-latest: Claude 3.5 Sonnet latest
              claude-3-7-sonnet-latest: Claude 3.7 Sonnet latest
              claude-sonnet-4-20250514: Claude Sonnet 4
              claude-opus-4-20250514: Claude Opus 4
            tooltip: Select the Anthropic Claude model used by the Constructor Fabric workflow.
    - caption: API Token
      type: string
      inputType: password
      name: api-token
      value: ""
      required: false
      tooltip: API token for the selected provider. Use an OpenAI key for openai or an Anthropic/Claude key for claude.

nodes:
  - image: ihorman/constructor-fabric:latest
    nodeType: docker
    displayName: Constructor Fabric
    cloudlets: 64
    nodeGroup: cp
    ports:
      - 80
      - 5900
    endpoints:
      - name: VNC
        privatePort: 5900
        protocol: TCP
    env:
      TZ: Europe/Kyiv
      USER: developer
      PASSWORD: ${globals.VNC_PASSWORD}
      VNC_PASSWORD: ${globals.VNC_PASSWORD}
      HTTP_PASSWORD: ${globals.VNC_PASSWORD}
      LLM_PROVIDER: ${settings.llm-provider}
      API_TOKEN: ${settings.api-token}
      OPENAI_API_KEY: ${settings.api-token}
      ANTHROPIC_API_KEY: ${settings.api-token}
      OPENAI_MODEL: ${settings.openai-model:gpt-5.5}
      CLAUDE_MODEL: ${settings.claude-model:claude-3-5-sonnet-latest}
      CF_IDE_PROFILE: all
      CF_PREINSTALLED_IDES: 1
      CF_HOME: /home/developer/constructor-fabric
      CF_PORT: ${globals.CF_PORT}
      ALSADEV: default
      PULSE_RUNTIME_PATH: /tmp/pulse-root
      PULSE_SERVER: unix:/tmp/pulse-root/native
      SDL_AUDIODRIVER: pulse
      AUDIODEV: default
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      JELASTIC_EXPOSE: 80
      JELASTIC_PORTS: 80
      RESOLUTION: 1280x720
      SCRIPT_VERSION: ${globals.SCRIPT_VERSION}
      CF_SOURCE_REF: ${globals.CF_SOURCE_REF}

onInstall:
  - bootstrap
  - verify

actions:
  bootstrap:
    - cmd[cp]: |-
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        # The currently published latest image can contain a stale Cursor apt source
        # and can be missing XKB files even when dpkg says xkb-data is installed.
        # Repair that root-level image state before the developer-only bootstrap starts.
        if [ ! -d /usr/share/X11/xkb/keycodes ] || [ ! -d /usr/share/X11/xkb/symbols ]; then
          find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 | xargs -0 grep -l 'api.cursor.com/apt' 2>/dev/null | xargs -r rm -f
          apt-get update
          apt-get install --reinstall -y --no-install-recommends xkb-data
          rm -rf /var/lib/apt/lists/*
        fi
        # The base VNC startup may leave /home/developer owned by root. Fix it
        # before downloading runtime scripts, then execute bootstrap as developer.
        chown -R developer:developer /home/developer
        curl --noproxy '*' -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/scripts/bootstrap.sh?v=${globals.SCRIPT_VERSION}" -o /tmp/constructor-fabric-bootstrap.sh
        chmod +x /tmp/constructor-fabric-bootstrap.sh
        chown developer:developer /tmp/constructor-fabric-bootstrap.sh
        su - developer -c "/tmp/constructor-fabric-bootstrap.sh"

  verify:
    - cmd[cp]: |-
        set -euo pipefail
        export NO_PROXY=localhost,127.0.0.1,::1
        export no_proxy=$NO_PROXY
        app_ready=0
        for i in $(seq 1 60); do
          if curl --noproxy "*" -fsS http://127.0.0.1:8081/health >/dev/null; then
            echo "Constructor Fabric app is up"
            curl --noproxy "*" -fsS http://127.0.0.1:8081/health
            app_ready=1
            break
          fi
          sleep 2
        done
        if [ "$app_ready" != "1" ]; then
          echo "Constructor Fabric app did not become ready in time" >&2
          exit 1
        fi
        check_port() {
          host="$1"; port="$2"; name="$3"; want_rfb="$4"
          if [ -z "$want_rfb" ]; then want_rfb=0; fi
          for i in $(seq 1 30); do
            if python3 - "$host" "$port" "$want_rfb" <<PYPORT
        import socket, sys
        host=sys.argv[1]; port=int(sys.argv[2]); want_rfb=sys.argv[3] == "1"
        s=socket.create_connection((host, port), timeout=2)
        if want_rfb:
            banner=s.recv(12).decode(errors="replace").strip()
            assert banner.startswith("RFB"), banner
        s.close()
        PYPORT
            then
              echo "$name is up on $host:$port"
              return 0
            fi
            sleep 2
          done
          echo "$name did not become ready" >&2
          echo "process list:" >&2
          ps aux | grep -E "Xvfb|x11vnc|websockify|supervisord" | grep -v grep >&2 || true
          echo "x11vnc.log:" >&2
          tail -120 /home/developer/constructor-fabric/x11vnc.log >&2 2>/dev/null || true
          echo "xvfb.log:" >&2
          tail -80 /home/developer/constructor-fabric/xvfb.log >&2 2>/dev/null || true
          return 1
        }
        check_port 127.0.0.1 5900 native-vnc 1
        check_port 127.0.0.1 6081 websockify 0
        cat >/tmp/constructor-fabric-verify-developer.sh <<VERIFYDEV
        set -euo pipefail
        test -f /home/developer/Desktop/Chromium.desktop || { echo "Chromium desktop launcher missing" >&2; exit 1; }
        grep -q "^Name=Chromium$" /home/developer/Desktop/Chromium.desktop || { echo "Chromium desktop launcher has wrong label" >&2; exit 1; }
        grep -Eq "^Exec=(/usr/local/bin/)?constructor-fabric-chromium" /home/developer/Desktop/Chromium.desktop || { echo "Chromium desktop launcher has wrong Exec" >&2; exit 1; }
        command -v constructor-fabric-chromium >/dev/null 2>&1 || { echo "Chromium wrapper missing" >&2; exit 1; }
        test -f /home/developer/Desktop/Terminal.desktop || { echo "Terminal desktop launcher missing" >&2; exit 1; }
        if command -v firefox >/dev/null 2>&1 || command -v firefox-esr >/dev/null 2>&1; then echo "Firefox is still installed" >&2; exit 1; fi
        echo "Chromium and Terminal desktop launchers are present and Firefox is absent"
        cd /home/developer/cyber-constructor
        cfc --version
        cfc info --json >/tmp/cfc-info.json
        cfc validate --json >/tmp/cfc-validate.json
        cfc agents --json >/tmp/cfc-agents.json
        python3 <<PYCHECK
        import json
        info=json.load(open("/tmp/cfc-info.json"))
        assert info["status"] == "FOUND", info
        assert info["relative_path"] == ".cf-constructor", info
        validate=json.load(open("/tmp/cfc-validate.json"))
        assert validate["status"] == "PASS", validate
        agents=json.load(open("/tmp/cfc-agents.json"))
        assert agents["status"] == "OK", agents
        text=json.dumps(agents).lower()
        required=["windsurf","cursor","claude","copilot","openai"]
        missing=[x for x in required if x not in text]
        assert not missing, {"missing": missing, "data": agents}
        print("cyber-constructor info is FOUND at .cf-constructor")
        print("cyber-constructor validate is PASS")
        print("cyber-constructor agents are OK for " + ", ".join(required))
        PYCHECK
        VERIFYDEV
        chmod +x /tmp/constructor-fabric-verify-developer.sh
        chown developer:developer /tmp/constructor-fabric-verify-developer.sh
        su - developer -c /tmp/constructor-fabric-verify-developer.sh
success: |
  ### Constructor Fabric is ready

  #### Access

  [Open Constructor Fabric noVNC desktop](https://${env.domain}/)

  #### VNC password

  Use this password if noVNC asks for it:

  `${globals.VNC_PASSWORD}`

  #### Desktop contents

  - noVNC opens the Constructor Fabric desktop at 1280x720.
  - The bottom LXDE panel contains launchers, clock, tray, and task switcher.
  - The Constructor Fabric Trainer opens as an Electron desktop app with copy-ready prompts.
  - The desktop is intentionally minimal: Trainer, Chromium, Terminal Emulator, VS Codium, Cursor, and Windsurf only.
  - Firefox is removed; the Chromium launcher runs the container-safe browser directly.
  - Claude/Codex integrations are generated inside the workspace for those IDEs; no misleading terminal-only IDE icons are shown.

  #### Workspace

  `/home/developer/workspaces/constructor-fabric-workspace`

  #### Install options used

  | Setting | Value |
  |---------|-------|
  | LLM provider | `${settings.llm-provider}` |
  | Model | `${settings.openai-model:}${settings.claude-model:}` |
  | API Token | configured from install form when provided |

  If you set an API Token in the install form, Constructor Fabric exports it into the generated workspace environment.
