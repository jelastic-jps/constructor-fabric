type: install
version: 0.4.57
id: constructor-fabric
baseUrl: https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/main/
name: Constructor Fabric
logo: assets/constructor-fabric-logo.png
categories:
  - apps/dev-and-admin-tools
  - apps/collaboration
  - apps/productivity

description:
  text: CLets AI define, build, and run software end to end -- with reusable components, operational automation, and built-in productivity measurement and insights.
  short: Constructor Fabric

targetRegions:
  type: vz7

ssl: true
skipNodeEmails: true

globals:
  VNC_PASSWORD: ${fn.password(16)}
  CF_PORT: 8081
  APP_PORT: 8081
  LLM_PROVIDER: openai
  OPENAI_MODEL: gpt-5.5
  CLAUDE_MODEL: claude-sonnet-4-6
  RESOLUTION: 1280x720
  SCRIPT_VERSION: continue-config-v0456-20260604-1
  CF_SOURCE_REF: de94910bf7df94d94d1474b583369af69160a723

settings:
  fields:
    - caption: LLM provider
      type: list
      inputType: string
      name: llm-provider
      default: openai
      values:
        openai: OpenAI
        claude: Claude
      tooltip: Select which LLM provider the Constructor Fabric workflow should use.
      showIf:
        openai:
          - caption: OpenAI model
            type: list
            inputType: string
            name: openai-model
            default: gpt-5.5
            values:
              gpt-5.5: OpenAI GPT-5.5
              gpt-5.4: OpenAI GPT-5.4
            tooltip: Select the OpenAI model used by the Constructor Fabric workflow.
        claude:
          - caption: Anthropic model
            type: list
            inputType: string
            name: claude-model
            default: claude-sonnet-4-6
            values:
              claude-sonnet-4-6: Claude Sonnet 4.6
              claude-opus-4-8: Claude Opus 4.8
              claude-haiku-4-5: Claude Haiku 4.5
            tooltip: Select the Anthropic Claude model used by the Constructor Fabric workflow.
    - caption: API Token
      type: string
      inputType: password
      name: api-token
      value: ""
      required: false
      tooltip: API token for the selected provider. Use an OpenAI key for openai or an Anthropic/Claude key for claude.

nodes:
  - image: ihorman/constructor-fabric:latest
    nodeType: docker
    displayName: Constructor Fabric
    cloudlets: 64
    nodeGroup: cp
    ports:
      - 80
    endpoints:
      - name: VS Codium Web
        privatePort: 80
        protocol: TCP
    env:
      TZ: Europe/Kyiv
      USER: developer
      ACCESS_TOKEN: ${globals.VNC_PASSWORD}
      LLM_PROVIDER: ${settings.llm-provider}
      API_TOKEN: ${settings.api-token}
      OPENAI_API_KEY: ${settings.api-token}
      ANTHROPIC_API_KEY: ${settings.api-token}
      OPENAI_MODEL: ${settings.openai-model}
      CLAUDE_MODEL: ${settings.claude-model:claude-sonnet-4-6}
      CF_IDE_PROFILE: all
      CF_PREINSTALLED_IDES: 1
      CF_HOME: /home/developer/constructor-fabric
      CF_PORT: ${globals.CF_PORT}
      ALSADEV: default
      PULSE_RUNTIME_PATH: /tmp/pulse-root
      PULSE_SERVER: unix:/tmp/pulse-root/native
      SDL_AUDIODRIVER: pulse
      AUDIODEV: default
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      JELASTIC_EXPOSE: 80
      JELASTIC_PORTS: 80
      RESOLUTION: 1280x720
      SCRIPT_VERSION: ${globals.SCRIPT_VERSION}
      CF_SOURCE_REF: ${globals.CF_SOURCE_REF}

onInstall:
  - bootstrap
  - verify

actions:
  bootstrap:
    - cmd[cp]: |-
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        # The currently published latest image can contain a stale Cursor apt source
        # and can be missing XKB files even when dpkg says xkb-data is installed.
        # Repair that root-level image state before the developer-only bootstrap starts.
        if [ ! -d /usr/share/X11/xkb/keycodes ] || [ ! -d /usr/share/X11/xkb/symbols ]; then
          find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 | xargs -0 grep -l 'api.cursor.com/apt' 2>/dev/null | xargs -r rm -f
          apt-get update
          apt-get install -y --reinstall xkb-data || { apt-get purge -y xkb-data; apt-get update; apt-get install -y xkb-data; }
          rm -rf /var/lib/apt/lists/*
        fi
        if ! command -v electron >/dev/null 2>&1 && [ -x /opt/node-current/bin/npm ]; then
          /opt/node-current/bin/npm install -g electron@latest
          ln -sf /opt/node-current/bin/electron /usr/local/bin/electron 2>/dev/null || true
        fi
        if ! command -v xdotool >/dev/null 2>&1; then
          apt-get update
          apt-get install -y --no-install-recommends xdotool
          rm -rf /var/lib/apt/lists/*
        fi
        # The base VNC startup may leave /home/developer owned by root. Fix it
        # before downloading runtime scripts, then execute bootstrap as developer.
        chown -R developer:developer /home/developer
        curl --noproxy '*' -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/scripts/bootstrap.sh?v=${globals.SCRIPT_VERSION}" -o /tmp/constructor-fabric-bootstrap.sh
        chmod +x /tmp/constructor-fabric-bootstrap.sh
        chown developer:developer /tmp/constructor-fabric-bootstrap.sh
        su - developer -c "/tmp/constructor-fabric-bootstrap.sh"

        # Post-bootstrap AI chat setup is intentionally inline in the JPS
        # manifest so it does not require changing CF_SOURCE_REF. The trainer
        # updater owns CF_SOURCE_REF; this block only wires VS Codium to open
        # Continue chat with the token passed via JPS settings.
        mkdir -p /home/developer/.continue /home/developer/.config/VSCodium/User /home/developer/constructor-fabric /home/developer/workspaces/constructor-fabric-workspace/.vscode
        # Download trainer HTML into workspace for Simple Browser view
        mkdir -p /home/developer/workspaces/constructor-fabric-workspace/trainer
        curl --noproxy '*' -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/trainer/index.html" -o /home/developer/workspaces/constructor-fabric-workspace/trainer/index.html 2>/dev/null || true
        # Start a lightweight HTTP server to serve the trainer (port 8082)
        /bin/sh -c "python3 -m http.server 8082 --directory /home/developer/workspaces/constructor-fabric-workspace/trainer --bind 127.0.0.1 >/dev/null 2>&1 &"
        cat >/tmp/write-continue-config.py <<'PYCFG'
        import json
        import os
        from pathlib import Path

        def clean(value, default=""):
            value = (value or "").strip()
            bad = {"", "-", "null", "None", "undefined"}
            if value in bad or value.startswith("$" + "{") or value.startswith("-"):
                return default
            return value

        provider = clean(os.environ.get("LLM_PROVIDER"), "openai")
        if provider == "claude":
            provider = "anthropic"
        if provider not in {"openai", "anthropic"}:
            provider = "openai"

        token = clean(os.environ.get("API_TOKEN"), "")
        openai_key = clean(os.environ.get("OPENAI_API_KEY"), token)
        anthropic_key = clean(os.environ.get("ANTHROPIC_API_KEY"), token)
        openai_model = clean(os.environ.get("OPENAI_MODEL"), "gpt-5.5")
        claude_model = clean(os.environ.get("CLAUDE_MODEL"), "claude-sonnet-4-6")
        model = claude_model if provider == "anthropic" else openai_model
        api_key = anthropic_key if provider == "anthropic" else openai_key

        out = Path("/home/developer/.continue/config.yaml")
        out.parent.mkdir(parents=True, exist_ok=True)

        def q(value):
            return json.dumps(str(value))

        lines = [
            "name: Constructor Fabric",
            "version: 1.0.0",
            "schema: v1",
            "env:",
            f"  OPENAI_API_KEY: {q(openai_key)}",
            f"  ANTHROPIC_API_KEY: {q(anthropic_key)}",
            f"  API_TOKEN: {q(token)}",
            "models:",
            "  - name: Constructor Fabric Chat",
            f"    provider: {q(provider)}",
            f"    model: {q(model)}",
        ]
        if api_key:
            lines.append(f"    apiKey: {q(api_key)}")
        lines.extend([
            "    roles:",
            "      - chat",
            "      - edit",
            "      - apply",
            "      - autocomplete",
            "context:",
            "  - provider: code",
            "  - provider: docs",
            "prompts:",
            "  - name: cf-constructor",
            "    description: Run the Constructor Fabric SDLC workflow using the generated .cf-constructor workspace, cfc CLI, and traceability rules.",
            "    prompt: |",
            "      You are Constructor Fabric inside the pre-initialized workspace.",
            "",
            "      User request:",
            "      {{{ input }}}",
            "",
            "      Use the local Constructor Fabric setup in this workspace:",
            "      - Read AGENTS.md and .cf-constructor/.gen/AGENTS.md before making changes.",
            "      - Use .cf-constructor as the Constructor Fabric adapter path.",
            "      - Use the generated agents and skills under .cf-constructor/.core/skills/cypilot when relevant.",
            "      - Use cfc/cf-constructor CLI commands for info, validation, artifacts, traceability, and generated agent workflow checks.",
            "      - Preserve traceability across PRD, ADR, DESIGN, DECOMPOSITION, FEATURE, CODE, tasks, tests, and review artifacts.",
            "      - When generating artifacts, write them into the workspace using Constructor Fabric conventions and run validation commands when possible.",
            "      - If validation fails, explain the failing checks and propose or apply fixes.",
        ])
        out.write_text("\n".join(lines) + "\n")

        # Developer-readable env file for the Codium/Continue extension host.
        env = Path("/home/developer/.constructor-fabric-ai.env")
        env.write_text("\n".join([
            f"API_TOKEN={token}",
            f"OPENAI_API_KEY={openai_key}",
            f"ANTHROPIC_API_KEY={anthropic_key}",
            f"LLM_PROVIDER={provider}",
            f"OPENAI_MODEL={openai_model}",
            f"CLAUDE_MODEL={claude_model}",
        ]) + "\n")
        env.chmod(0o600)

        print(f"Continue config written: provider={provider}, model={model}, api_key_len={len(api_key)}")
        PYCFG
        python3 /tmp/write-continue-config.py
        cat >/home/developer/.config/VSCodium/User/settings.json <<VSCODESETTINGS
        {
          "workbench.startupEditor": "none",
          "security.workspace.trust.enabled": false,
          "security.workspace.trust.startupPrompt": "never",
          "continue.telemetryEnabled": false,
          "continue.showInlineTip": false
        }
        VSCODESETTINGS
        cat >/home/developer/.config/VSCodium/User/keybindings.json <<VSCODEKEYS
        [
          { "key": "ctrl+alt+c", "command": "continue.focusContinueInput" }
        ]
        VSCODEKEYS
        cat >/home/developer/workspaces/constructor-fabric-workspace/.vscode/cfc-commands.md <<CFCMDS
        Continue: Focus Continue Chat
        Focus Continue Chat
        View: Show Continue
        CFCMDS

        # Patch Codium WebView resource loader for browsers/Jelastic proxy setups
        # that require ReadableStream to be passed as a transferable. Without
        # this, Continue's webview can fail with:
        # DataCloneError: ReadableStream could not be cloned because it was not transferred.
        cat >/tmp/patch-codium-webview-transfer.py <<'PYWEBVIEW'
        import re
        from pathlib import Path

        roots = [Path('/usr/share'), Path('/usr/lib'), Path('/opt')]
        candidates = []
        for root in roots:
            if not root.exists():
                continue
            for path in root.rglob('index.html'):
                s = str(path)
                if 'webview' in s and 'browser' in s and 'pre' in s:
                    candidates.append(path)

        patched = []
        pattern = re.compile(
            r"(hostMessaging\.onMessage\('did-load-resource', \(_event, data\) => \{\s*)"
            r"(assertIsDefined\(navigator\.serviceWorker\.controller\)\.postMessage\(\{ channel: 'did-load-resource', data \}\);)"
            r"(\s*\}\);)",
            re.MULTILINE,
        )
        replacement = (
            "\\1"
            "const transfer = data.stream ? [data.stream] : [];\n"
            "\t\t\t\tassertIsDefined(navigator.serviceWorker.controller).postMessage({ channel: 'did-load-resource', data }, transfer);"
            "\\3"
        )
        for path in candidates:
            text = path.read_text(errors='replace')
            if "const transfer = data.stream ? [data.stream] : []" in text:
                patched.append(f"already patched: {path}")
                continue
            new_text, count = pattern.subn(replacement, text, count=1)
            if count:
                path.write_text(new_text)
                patched.append(f"patched: {path}")
        if not patched:
            raise SystemExit("No Codium webview pre/index.html patched; candidates=" + ",".join(map(str, candidates[:20])))
        print("\n".join(patched))
        PYWEBVIEW
        python3 /tmp/patch-codium-webview-transfer.py | tee /tmp/codium-webview-transfer-patch.log

        # Kill VNC/noVNC stack before starting Codium. Kill tini first or it
        # restarts supervisord/nginx and noVNC wins port 80 back.
        sudo pkill -9 -f "tini.*supervisord" 2>/dev/null || true
        sudo supervisorctl stop all 2>/dev/null || true
        sudo supervisorctl shutdown 2>/dev/null || true
        sleep 2
        sudo pkill -9 -f supervisord 2>/dev/null || true
        sudo pkill -9 -f nginx 2>/dev/null || true
        sudo pkill -9 -f Xvfb 2>/dev/null || true
        sudo pkill -9 -f x11vnc 2>/dev/null || true
        sudo pkill -9 -f websockify 2>/dev/null || true
        for _port_wait in $(seq 1 20); do
          if ! ss -tlnp 2>/dev/null | grep -q ":80 "; then break; fi
          sleep 1
        done
        cat >/home/developer/constructor-fabric/start-codium-web.sh <<'STARTWEB'
        #!/bin/sh
        set -u
        case "${HOME:-}" in
          ""|-*) HOME=/home/developer ;;
        esac
        export HOME
        if [ -f "${HOME}/.constructor-fabric-ai.env" ]; then
          set -a
          . "${HOME}/.constructor-fabric-ai.env"
          set +a
        fi
        export PATH="${HOME}/.local/bin:/opt/node-current/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
        workspace="${HOME}/workspaces/constructor-fabric-workspace"
        mkdir -p "$workspace"
        cd "$workspace" || exit 1
        exec codium serve-web --port 80 --host 0.0.0.0 \
          --without-connection-token \
          --accept-server-license-terms \
          --server-data-dir "${HOME}/.config/VSCodium"
        STARTWEB
        chmod +x /home/developer/constructor-fabric/start-codium-web.sh
        chown -R developer:developer /home/developer/.constructor-fabric-ai.env /home/developer/.continue /home/developer/.config/VSCodium /home/developer/constructor-fabric/start-codium-web.sh /home/developer/workspaces
        # Continue is baked into the Docker image. Runtime .vsix installation is
        # intentionally avoided because codium-tunnel serve-web does not reliably
        # load extensions installed after image build.
        if ! ls -d /home/developer/.config/VSCodium/extensions/continue.continue-* >/dev/null 2>&1; then
          echo "WARNING: baked Continue extension directory is missing before codium start" >&2
        fi
        # Start VSCodium web server in background (root for port 80). Do not end
        # this JPS line with a raw '&' because Jelastic can wrap it as '&;)'.
        /bin/sh -c "/home/developer/constructor-fabric/start-codium-web.sh > /home/developer/codium-web.log 2>&1 &"
        sleep 2

  verify:
    - cmd[cp]: |-
        set -euo pipefail
        export NO_PROXY=localhost,127.0.0.1,::1
        export no_proxy=$NO_PROXY
        app_ready=0
        for i in $(seq 1 60); do
          if curl --noproxy "*" -fsS http://127.0.0.1:8081/health >/dev/null; then
            echo "Constructor Fabric app is up"
            curl --noproxy "*" -fsS http://127.0.0.1:8081/health
            app_ready=1
            break
          fi
          sleep 2
        done
        if [ "$app_ready" != "1" ]; then
          echo "Constructor Fabric app did not become ready in time" >&2
          exit 1
        fi
        # Wait for VS Codium web server on port 80 (not noVNC).
        codium_ready=0
        for i in $(seq 1 40); do
          # Check that codium serve-web process is running
          if pgrep -f "codium.*serve-web" >/dev/null 2>&1; then
            # Verify port 80 is responding and is NOT noVNC
            page=$(curl --noproxy "*" -fsS http://127.0.0.1:80/ 2>/dev/null || true)
            if [ -n "$page" ] && ! echo "$page" | grep -qi "noVNC"; then
              echo "VS Codium web server is up on port 80"
              codium_ready=1
              break
            fi
          fi
          sleep 2
        done
        if [ "$codium_ready" != "1" ]; then
          echo "VS Codium web server did not start on port 80" >&2
          if curl --noproxy "*" -fsS http://127.0.0.1:80/ 2>/dev/null | grep -qi "noVNC"; then
            echo "ERROR: noVNC is still being served on port 80" >&2
          fi
          echo "process list:" >&2
          ps aux | grep -E "codium|node|supervisor|nginx" | grep -v grep >&2 || true
          echo "codium-web.log:" >&2
          tail -80 /home/developer/codium-web.log >&2 2>/dev/null || true
          exit 1
        fi
        cat >/tmp/constructor-fabric-verify-developer.sh <<VERIFYDEV
        set -euo pipefail
        test -f /home/developer/constructor-fabric/start-codium-web.sh || { echo "VS Codium web startup script missing" >&2; exit 1; }
        grep -q "serve-web" /home/developer/constructor-fabric/start-codium-web.sh || { echo "start-codium-web.sh does not use serve-web" >&2; exit 1; }
        command -v codium >/dev/null 2>&1 || { echo "VS Codium binary missing" >&2; exit 1; }
        test -f /home/developer/.continue/config.yaml || { echo "Continue config missing" >&2; exit 1; }
        grep -q "provider: " /home/developer/.continue/config.yaml || { echo "Continue provider missing" >&2; exit 1; }
        grep -q "model: " /home/developer/.continue/config.yaml || { echo "Continue model missing" >&2; exit 1; }
        grep -q "name: cf-constructor" /home/developer/.continue/config.yaml || { echo "Continue cf-constructor prompt missing" >&2; exit 1; }
        test -d /home/developer/.config/VSCodium/extensions/continue.continue-* || { echo "Continue extension missing in VS Codium" >&2; tail -80 /tmp/continue-install.log >&2 2>/dev/null || true; exit 1; }
        echo "VS Codium web server and Continue extension are configured"
        cd /home/developer/cyber-constructor
        cfc --version
        cfc info --json >/tmp/cfc-info.json
        cfc validate --json >/tmp/cfc-validate.json
        cfc agents --json >/tmp/cfc-agents.json
        python3 <<PYCHECK
        import json
        info=json.load(open("/tmp/cfc-info.json"))
        assert info["status"] == "FOUND", info
        assert info["relative_path"] == ".cf-constructor", info
        validate=json.load(open("/tmp/cfc-validate.json"))
        assert validate["status"] == "PASS", validate
        agents=json.load(open("/tmp/cfc-agents.json"))
        assert agents["status"] == "OK", agents
        text=json.dumps(agents).lower()
        required=["windsurf","claude","copilot","openai"]
        missing=[x for x in required if x not in text]
        assert not missing, {"missing": missing, "data": agents}
        print("cyber-constructor info is FOUND at .cf-constructor")
        print("cyber-constructor validate is PASS")
        print("cyber-constructor agents are OK for " + ", ".join(required))
        PYCHECK
        VERIFYDEV
        chmod +x /tmp/constructor-fabric-verify-developer.sh
        chown developer:developer /tmp/constructor-fabric-verify-developer.sh
        su - developer -c /tmp/constructor-fabric-verify-developer.sh
success: |
  ### Constructor Fabric is ready

  #### Access

  [Open VS Codium](https://${env.domain}/)

  #### Access token

  Enter this token when VS Codium asks for it:

  `${globals.VNC_PASSWORD}`

  #### What you get

  - VS Codium runs as a web IDE in your browser on port 80.
  - The Continue extension is pre-installed and configured with your selected LLM provider.
  - The workspace is at `/home/developer/workspaces/constructor-fabric-workspace`.

  #### Workspace

  `/home/developer/workspaces/constructor-fabric-workspace`

  #### Install options used

  | Setting | Value |
  |---------|-------|
  | LLM provider | `${settings.llm-provider}` |
  | Model | `${settings.openai-model:}${settings.claude-model:}` |
  | API Token | configured from install form when provided |

  If you set an API Token in the install form, Constructor Fabric exports it into the generated workspace environment.

