type: install
version: 0.6.0
id: constructor-fabric
baseUrl: https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/main/
name: Constructor Fabric
logo: assets/constructor-fabric-logo.png
categories:
  - apps/dev-and-admin-tools
  - apps/collaboration
  - apps/productivity

description:
  text: A browser-based AI development environment where a guided Trainer walks you through building a real application with Constructor Studio — from requirements and design to validated, traceable, running code.
  short: Constructor Studio Training Environment

ssl: true
skipNodeEmails: true

globals:
  SCRIPT_VERSION: agent-choice-20260723-1
  CF_SOURCE_REF: main
  NOTIFY_WEBHOOK_URL: "XXX"
  NOTIFY_SECRET: "XXX"

settings:
  fields:
    - caption: Choose AI Coding Agent to deploy
      type: list
      inputType: string
      name: coding-agent
      default: claude
      values:
        claude: Claude Code by Anthropic
        codex: Codex by OpenAI
      tooltip: The AI coding agent deployed into your training environment.
    - caption: Set Constructor Studio Environment Password
      type: string
      inputType: password
      name: ide-password
      required: true
      tooltip: Password for signing in to your training environment. It is stored only as a hash — keep it safe; it is not displayed or recoverable after installation.

nodes:
  - image: sstimss/constructor-fabric:20260721
    nodeType: docker
    displayName: Constructor Studio Training
    cloudlets: 64
    nodeGroup: cp
    extIPs: 1
    ports:
      - 8080
    endpoints:
      - name: Constructor Studio Training
        privatePort: 8080
        protocol: TCP
    env:
      TZ: Europe/Kyiv
      USER: developer
      HOME: /home/developer
      CF_HOME: /home/developer/constructor-fabric
      CF_WORKSPACE: /home/developer/workspaces/constructor-fabric-workspace
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      JELASTIC_EXPOSE: 8080
      JELASTIC_PORTS: 8080
      SCRIPT_VERSION: agent-choice-20260723-1
      CF_SOURCE_REF: main

onInstall:
  - writeAgentChoice
  - writePassword
  - bootstrap
  - verify
  - notify

actions:
  writeAgentChoice:
    # File transport (like the password): su/sudo transitions during bootstrap
    # drop container env vars. Read by install-coding-agent.sh and verify.
    - writeFile[cp]:
        path: /home/developer/.cf-coding-agent
        body: ${settings.coding-agent:claude}
    - cmd[cp]: chown developer:developer /home/developer/.cf-coding-agent

  writePassword:
    # Transport only: start-services.sh argon2-hashes this into code-server's
    # config and deletes the plaintext file.
    - writeFile[cp]:
        path: /home/developer/.code-server-password
        body: ${settings.ide-password}
    - cmd[cp]: chown developer:developer /home/developer/.code-server-password && chmod 600 /home/developer/.code-server-password

  bootstrap:
    - cmd[cp]: |-
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        export HOME=/home/developer
        export USER=developer
        export PATH=/opt/node-current/bin:/home/developer/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH

        if ! id developer >/dev/null 2>&1; then
          useradd -m -u 1000 -s /bin/bash developer
        fi
        install -d -m 0755 /etc/sudoers.d
        printf '%s\n' 'developer ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/developer
        chmod 0440 /etc/sudoers.d/developer


        if ! command -v code-server >/dev/null 2>&1; then
          echo "Installing code-server..."
          CODE_SERVER_VERSION=4.129.0
          curl --noproxy '*' --retry 3 --retry-delay 2 --retry-connrefused -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" -o /tmp/code-server.tar.gz
          tar -xzf /tmp/code-server.tar.gz --strip-components=1 -C /usr/local
          rm -f /tmp/code-server.tar.gz
          code-server --version
        fi

        mkdir -p /home/developer/constructor-fabric /home/developer/workspaces/constructor-fabric-workspace
        chown -R developer:developer /home/developer

        curl --noproxy '*' --retry 3 --retry-delay 2 --retry-connrefused -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/scripts/bootstrap.sh?v=${globals.SCRIPT_VERSION}" -o /tmp/constructor-fabric-bootstrap.sh
        chmod +x /tmp/constructor-fabric-bootstrap.sh
        chown developer:developer /tmp/constructor-fabric-bootstrap.sh
        su developer -c "/tmp/constructor-fabric-bootstrap.sh"

  verify:
    - cmd[cp]: |-
        set -euo pipefail
        export NO_PROXY=localhost,127.0.0.1,::1
        export no_proxy=$NO_PROXY

        ide_ready=0
        for i in $(seq 1 60); do
          if curl --noproxy "*" -fsS http://127.0.0.1:8080/ >/dev/null 2>&1; then
            echo "plain code-server is up on port 8080"
            ide_ready=1
            break
          fi
          sleep 2
        done
        if [ "$ide_ready" != "1" ]; then
          echo "code-server did not start on port 8080" >&2
          tail -80 /home/developer/constructor-fabric/code-server.log >&2 2>/dev/null || true
          exit 1
        fi

        python3 - <<'PYCHECK'
        import json
        from pathlib import Path
        ext = Path('/home/developer/.local/share/code-server/extensions/constructor-fabric.constructor-fabric-trainer-2.0.0')
        for rel in ('package.json', 'extension.js', 'ui/index.html', 'ui/trainer.js', 'ui/trainer.css', 'content/curriculum.json', 'content/brief.md'):
            assert (ext / rel).exists(), str(ext / rel)
        pkg = json.loads((ext / 'package.json').read_text())
        assert 'onStartupFinished' in pkg.get('activationEvents', []), pkg
        curriculum = json.loads((ext / 'content/curriculum.json').read_text())
        assert len(curriculum['steps']) >= 12, 'trainer curriculum must have >= 12 steps'
        registry = json.loads(Path('/home/developer/.local/share/code-server/extensions/extensions.json').read_text())
        assert any((e.get('identifier') or {}).get('id') == 'constructor-fabric.constructor-fabric-trainer' for e in registry), registry
        settings = Path('/home/developer/.local/share/code-server/User/settings.json')
        assert settings.exists(), settings
        data = json.loads(settings.read_text())
        assert data.get('workbench.colorTheme') in ('Default Dark Modern', 'Dark Modern')
        assert data.get('workbench.startupEditor') == 'none'
        assert data.get('window.restoreWindows') == 'none'
        assert data.get('workbench.welcomePage.walkthroughs.openOnInstall') is False, 'welcome walkthrough auto-open is not suppressed'
        extensions = Path('/home/developer/.local/share/code-server/extensions')
        names = {p.name.lower() for p in extensions.iterdir() if p.is_dir()} if extensions.exists() else set()
        # code-server >= 4.127.0 ships the unified GitHub Copilot (completions +
        # Chat) as a built-in; marketplace copies must NOT be user-installed.
        assert not any(name.startswith('github.copilot') for name in names), names
        # Agent-dependent surface: the install-form choice decides which chat
        # agent is deployed and whether the built-in Copilot stays.
        try:
            agent = Path('/home/developer/.cf-coding-agent').read_text().strip() or 'copilot'
        except OSError:
            agent = 'copilot'
        if agent not in ('claude', 'codex', 'copilot'):
            agent = 'copilot'
        builtin_copilot = Path('/usr/local/lib/vscode/extensions/copilot')
        if agent == 'copilot':
            assert data.get('github.copilot.editor.enableAutoCompletions') is True
            assert data.get('chat.commandCenter.enabled') is True
            builtin_chat = json.loads((builtin_copilot / 'package.json').read_text())
            assert builtin_chat.get('name') == 'copilot-chat', builtin_chat.get('name')
        else:
            expected_ext = {'claude': 'anthropic.claude-code', 'codex': 'openai.chatgpt'}[agent]
            assert any(n.startswith(expected_ext) for n in names), (expected_ext, names)
            assert not builtin_copilot.exists(), 'built-in Copilot must be removed for agent=' + agent
            assert data.get('chat.disableAIFeatures') is True, 'built-in chat must be disabled for agent=' + agent
            assert data.get('chat.commandCenter.enabled') is False
        trainer_ext_js = (ext / 'extension.js').read_text()
        # The built-in unified Copilot handles its own sign-in; the trainer
        # must not override the chat setup sign-in command or request extra
        # GitHub scopes (read:user/repo/workflow).
        assert 'triggerSetupForceSignIn' not in (ext / 'package.json').read_text(), 'stale Copilot sign-in bridge in trainer package.json'
        assert "'read:user'" not in trainer_ext_js, 'stale Copilot sign-in scope escalation in trainer extension'
        code_server_host = Path('/usr/local/lib/vscode/out/vs/workbench/api/node/extensionHostProcess.js')
        assert 'value:globalThis.navigator' in code_server_host.read_text(), 'code-server navigator guard is not patched'
        # The chat setup must request minimal GitHub scopes first; the upstream
        # broad-scopes-first list is inlined into the workbench web bundle.
        web_main = Path('/usr/local/lib/vscode/out/vs/workbench/workbench.web.main.internal.js')
        assert 'providerScopes:[["read:user"' not in web_main.read_text(), 'chat provider scopes not patched in workbench web bundle'
        supervisor_conf = Path('/etc/supervisor/conf.d/code-server.conf').read_text()
        assert 'start-code-server.sh' in supervisor_conf or '--enable-proposed-api GitHub.copilot-chat' in supervisor_conf, supervisor_conf
        # Workspace trust must stay disabled: in restricted mode the built-in
        # Copilot and the trainer extension (no untrustedWorkspaces capability)
        # are silently not loaded into the session.
        assert '--disable-workspace-trust' in supervisor_conf, supervisor_conf
        ws = Path('/home/developer/workspaces/constructor-fabric-workspace')
        # Greenfield training precondition: the trainee starts with an empty
        # artifact tree and no application code.
        assert not (ws / 'architecture').exists(), 'workspace must start without architecture/'
        assert not (ws / 'src').exists(), 'workspace must start without src/'
        assert not (ws / '.cf-studio/artifacts').exists(), 'workspace must start without registered artifacts'
        # The Studio core runtime must be complete, or SDLC kit preset
        # workflows fail at runtime ("missing write-docs.md").
        assert (ws / '.cf-studio/.core/workflows/write-docs.md').exists(), '.core/workflows missing — cache copy incomplete'
        # Password hygiene: plaintext transport file consumed and deleted;
        # code-server holds only the argon2 hash.
        assert not Path('/home/developer/.code-server-password').exists(), 'plaintext IDE password file must not persist'
        csconf = Path('/home/developer/.config/code-server/config.yaml').read_text()
        assert 'hashed-password:' in csconf, 'code-server must authenticate via hashed-password'
        login_html = Path('/usr/local/src/browser/pages/login.html').read_text()
        assert 'autoLoginFromUrl' not in login_html, 'legacy ?password= auto-login must be removed'
        print('code-server trainer webview extension and dark theme are configured')
        PYCHECK

        cd /home/developer/studio
        cfs --version
        cfs info --json >/tmp/cfs-info.json
        cfs validate --json >/tmp/cfs-validate.json
        python3 <<'PYCHECK'
        import json
        info=json.load(open('/tmp/cfs-info.json'))
        assert info['status'] == 'FOUND', info
        validate=json.load(open('/tmp/cfs-validate.json'))
        assert validate['status'] == 'PASS', validate
        print('constructor-studio info is FOUND')
        print('constructor-studio validate is PASS')
        PYCHECK

        echo "=== All checks passed ==="

  notify:
    - cmd[cp]: |-
        # Call notify-server webhook. MUST NOT fail.
        WEBHOOK_URL="${globals.NOTIFY_WEBHOOK_URL}"
        NOTIFY_SECRET="${globals.NOTIFY_SECRET}"
        DOMAIN="${env.domain}"

        if [ -z "$WEBHOOK_URL" ]; then
          echo "[notify] NOTIFY_WEBHOOK_URL not set, skipping"
          exit 0
        fi

        curl --noproxy '*' -sS --max-time 10 \
          -X POST "$WEBHOOK_URL" \
          -H "Content-Type: application/json" \
          -d "{\"domain\":\"${DOMAIN}\",\"secret\":\"${NOTIFY_SECRET}\"}" \
          2>&1 || echo "[notify] webhook failed — non-critical"


success: |
  ### Constructor Studio Training Environment is ready

  Open your environment:
  [https://${env.domain}/](https://${env.domain}/)

  Sign in with the environment password you chose during the sign up process.
  For security it is stored only as a hash and cannot be displayed or
  recovered — if lost, reinstall the environment.
