type: install
version: 0.5.4
id: constructor-fabric
baseUrl: https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/main/
name: Constructor Fabric
logo: assets/constructor-fabric-logo.png
categories:
  - apps/dev-and-admin-tools
  - apps/collaboration
  - apps/productivity

description:
  text: Lets AI define, build, and run software end to end with a plain browser code-server workspace and built-in trainer.
  short: Constructor Fabric

ssl: true
skipNodeEmails: true

globals:
  LLM_PROVIDER: openai
  OPENAI_MODEL: gpt-5.5
  CLAUDE_MODEL: claude-sonnet-4-6
  SCRIPT_VERSION: sed-pwd-20260625-1
  CF_SOURCE_REF: 890a99687cad7425f69e069f7217c92c316726d3
  # Notification SMTP credentials (set by platform admin)
  NOTIFY_RECIPIENT: "contact@constructorfabric.org"
  NOTIFY_RECIPIENT2: "ik@virtuozzo.com"
  SMTP_HOST: "smtp.gmail.com"
  SMTP_PORT: "587"
  SMTP_USER: "REDACTED_EMAIL"
  SMTP_PASS: "REDACTED_SMTP_PASS"
  SMTP_SENDER: "REDACTED_EMAIL"

settings:
  fields:
    - caption: LLM provider
      type: list
      inputType: string
      name: llm-provider
      default: openai
      values:
        openai: OpenAI
        claude: Claude
      tooltip: Select which LLM provider the Constructor Fabric workflow should use.
      showIf:
        openai:
          - caption: OpenAI model
            type: list
            inputType: string
            name: openai-model
            default: gpt-5.5
            values:
              gpt-5.5: OpenAI GPT-5.5
              gpt-5.4: OpenAI GPT-5.4
            tooltip: Select the OpenAI model used by the Constructor Fabric workflow.
        claude:
          - caption: Anthropic model
            type: list
            inputType: string
            name: claude-model
            default: claude-sonnet-4-6
            values:
              claude-sonnet-4-6: Claude Sonnet 4.6
              claude-opus-4-8: Claude Opus 4.8
              claude-haiku-4-5: Claude Haiku 4.5
            tooltip: Select the Anthropic Claude model used by the Constructor Fabric workflow.
    - caption: API Token
      type: string
      inputType: password
      name: api-token
      value: ""
      required: false
      tooltip: API token for the selected provider. Use an OpenAI key for openai or an Anthropic/Claude key for claude.
    - caption: IDE Password (optional)
      type: string
      inputType: password
      name: ide-password
      value: ""
      required: false
      tooltip: Password for code-server IDE access. Leave empty to auto-generate.

nodes:
  - image: ihorman/constructor-fabric:latest
    nodeType: docker
    displayName: Constructor Fabric
    cloudlets: 64
    nodeGroup: cp
    extIPs: 1
    ports:
      - 8080
    endpoints:
      - name: Constructor Fabric
        privatePort: 8080
        protocol: TCP
    env:
      TZ: Europe/Kyiv
      USER: developer
      HOME: /home/developer
      LLM_PROVIDER: ${settings.llm-provider}
      API_TOKEN: ${settings.api-token}
      OPENAI_API_KEY: ${settings.api-token}
      ANTHROPIC_API_KEY: ${settings.api-token}
      OPENAI_MODEL: ${settings.openai-model:gpt-5.5}
      CLAUDE_MODEL: ${settings.claude-model:claude-sonnet-4-6}
      CODE_SERVER_PASSWORD: ${settings.ide-password:}
      CF_HOME: /home/developer/constructor-fabric
      CF_WORKSPACE: /home/developer/workspaces/constructor-fabric-workspace
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      JELASTIC_EXPOSE: 8080
      JELASTIC_PORTS: 8080
      SCRIPT_VERSION: sed-pwd-20260625-1
      CF_SOURCE_REF: 890a99687cad7425f69e069f7217c92c316726d3

onInstall:
  - bootstrap
  - verify
  - notify

actions:
  bootstrap:
    - cmd[cp]: |-
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        export HOME=/home/developer
        export USER=developer
        export PATH=/opt/node-current/bin:/home/developer/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH

        if ! id developer >/dev/null 2>&1; then
          useradd -m -u 1000 -s /bin/bash developer
        fi
        install -d -m 0755 /etc/sudoers.d
        printf '%s\n' 'developer ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/developer
        chmod 0440 /etc/sudoers.d/developer


        if ! command -v code-server >/dev/null 2>&1; then
          echo "Installing code-server..."
          CODE_SERVER_VERSION=4.104.2
          curl --noproxy '*' -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" -o /tmp/code-server.tar.gz
          tar -xzf /tmp/code-server.tar.gz --strip-components=1 -C /usr/local
          rm -f /tmp/code-server.tar.gz
          code-server --version
        fi

        mkdir -p /home/developer/constructor-fabric /home/developer/workspaces/constructor-fabric-workspace
        chown -R developer:developer /home/developer

        umask 077
        {
          echo "LLM_PROVIDER=${settings.llm-provider}"
          echo "API_TOKEN=${settings.api-token}"
          echo "OPENAI_API_KEY=${settings.api-token}"
          echo "ANTHROPIC_API_KEY=${settings.api-token}"
          echo "OPENAI_MODEL=${settings.openai-model:gpt-5.5}"
          echo "CLAUDE_MODEL=${settings.claude-model:claude-sonnet-4-6}"
        } >/home/developer/.constructor-fabric-ai.env
        chmod 600 /home/developer/.constructor-fabric-ai.env
        chown developer:developer /home/developer/.constructor-fabric-ai.env

        curl --noproxy '*' -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/scripts/bootstrap.sh?v=${globals.SCRIPT_VERSION}" -o /tmp/constructor-fabric-bootstrap.sh
        chmod +x /tmp/constructor-fabric-bootstrap.sh
        chown developer:developer /tmp/constructor-fabric-bootstrap.sh
        su developer -c "export CODE_SERVER_PASSWORD=${CODE_SERVER_PASSWORD:-}; /tmp/constructor-fabric-bootstrap.sh"

  verify:
    - cmd[cp]: |-
        set -euo pipefail
        export NO_PROXY=localhost,127.0.0.1,::1
        export no_proxy=$NO_PROXY

        ide_ready=0
        for i in $(seq 1 60); do
          if curl --noproxy "*" -fsS http://127.0.0.1:8080/ >/dev/null 2>&1; then
            echo "plain code-server is up on port 8080"
            ide_ready=1
            break
          fi
          sleep 2
        done
        if [ "$ide_ready" != "1" ]; then
          echo "code-server did not start on port 8080" >&2
          tail -80 /home/developer/constructor-fabric/code-server.log >&2 2>/dev/null || true
          exit 1
        fi

        python3 - <<'PYCHECK'
        import json
        from pathlib import Path
        ext = Path('/home/developer/.local/share/code-server/extensions/constructor-fabric.constructor-fabric-trainer-1.0.0')
        assert (ext / 'package.json').exists(), ext
        assert (ext / 'extension.js').exists(), ext
        pkg = json.loads((ext / 'package.json').read_text())
        assert 'onStartupFinished' in pkg.get('activationEvents', []), pkg
        registry = json.loads(Path('/home/developer/.local/share/code-server/extensions/extensions.json').read_text())
        assert any((e.get('identifier') or {}).get('id') == 'constructor-fabric.constructor-fabric-trainer' for e in registry), registry
        settings = Path('/home/developer/.local/share/code-server/User/settings.json')
        assert settings.exists(), settings
        data = json.loads(settings.read_text())
        assert data.get('workbench.colorTheme') == 'Default Dark Modern'
        assert data.get('workbench.startupEditor') == 'none'
        assert data.get('window.restoreWindows') == 'none'
        terminal_env = data.get('terminal.integrated.env.linux', {})
        assert terminal_env.get('LLM_PROVIDER') in ('openai', 'claude'), terminal_env
        assert data.get('github.copilot.editor.enableAutoCompletions') is True
        assert data.get('chat.commandCenter.enabled') is True
        extensions = Path('/home/developer/.local/share/code-server/extensions')
        names = {p.name.lower() for p in extensions.iterdir() if p.is_dir()} if extensions.exists() else set()
        assert any(name.startswith('github.copilot-') or name == 'github.copilot' for name in names), names
        assert 'github.copilot-chat-0.31.1' in names, names
        trainer_ext_js = (ext / 'extension.js').read_text()
        assert 'workbench.action.chat.triggerSetupForceSignIn' in trainer_ext_js, 'Copilot sign-in bridge command is missing'
        assert "['read:user', 'repo', 'user:email', 'workflow']" in trainer_ext_js, 'Copilot sign-in bridge does not request Copilot GitHub scopes'
        code_server_host = Path('/usr/local/lib/vscode/out/vs/workbench/api/node/extensionHostProcess.js')
        assert 'value:globalThis.navigator' in code_server_host.read_text(), 'code-server navigator guard is not patched'
        supervisor_conf = Path('/etc/supervisor/conf.d/code-server.conf').read_text()
        assert 'start-code-server.sh' in supervisor_conf or '--enable-proposed-api GitHub.copilot-chat' in supervisor_conf, supervisor_conf
        trainer = Path('/home/developer/workspaces/constructor-fabric-workspace/.constructor-fabric-trainer/index.html')
        assert trainer.exists() and trainer.stat().st_size > 100, trainer
        assert Path('/home/developer/.constructor-fabric-ai.env').exists()
        print('code-server trainer webview extension, provider env, and dark theme are configured')
        PYCHECK

        cd /home/developer/cyber-constructor
        cfc --version
        cfc info --json >/tmp/cfc-info.json
        cfc validate --json >/tmp/cfc-validate.json
        python3 <<'PYCHECK'
        import json
        info=json.load(open('/tmp/cfc-info.json'))
        assert info['status'] == 'FOUND', info
        validate=json.load(open('/tmp/cfc-validate.json'))
        assert validate['status'] == 'PASS', validate
        print('cyber-constructor info is FOUND')
        print('cyber-constructor validate is PASS')
        PYCHECK

        echo "=== All checks passed ==="

  notify:
    - cmd[cp]: |-
        # Admin notification. MUST NOT fail.
        DOMAIN="${env.domain}"
        CUSTOMER="${user.email}"
        PROVIDER="${settings.llm-provider}"
        MODEL="${settings.openai-model:gpt-5.5}${settings.claude-model:claude-sonnet-4-6}"
        SMTP_HOST="${globals.SMTP_HOST}"
        SMTP_PORT="${globals.SMTP_PORT}"
        SMTP_USER="${globals.SMTP_USER}"
        SMTP_PASS="${globals.SMTP_PASS}"
        RCPT1="${globals.NOTIFY_RECIPIENT}"
        RCPT2="${globals.NOTIFY_RECIPIENT2}"

        if [ -z "$SMTP_USER" ] || [ -z "$SMTP_PASS" ] || ([ -z "$RCPT1" ] && [ -z "$RCPT2" ]); then
          echo "[notify] SMTP or recipients not configured, skipping"
          exit 0
        fi

        RECIPIENTS=""
        [ -n "$RCPT1" ] && RECIPIENTS="$RCPT1"
        [ -n "$RCPT2" ] && RECIPIENTS="$RECIPIENTS,$RCPT2"
        RECIPIENTS="$(echo "$RECIPIENTS" | sed 's/^,//')"

        python3 -c "
        import smtplib, sys
        from email.mime.text import MIMEText
        from datetime import datetime, timezone
        ts = datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')
        domain = '$DOMAIN'
        customer = '$CUSTOMER'
        provider = '$PROVIDER'
        model = '$MODEL'
        body = '<h2>New Constructor Fabric instance</h2>' \
               '<table style=\"border-collapse:collapse;font-size:15px;\">' \
               '<tr><td style=\"padding:4px 12px;font-weight:bold;\">Domain</td><td style=\"padding:4px 12px;\"><a href=\"https://' + domain + '/\">' + domain + '</a></td></tr>' \
               '<tr><td style=\"padding:4px 12px;font-weight:bold;\">Customer</td><td style=\"padding:4px 12px;\">' + customer + '</td></tr>' \
               '<tr><td style=\"padding:4px 12px;font-weight:bold;\">Provider</td><td style=\"padding:4px 12px;\">' + provider + '</td></tr>' \
               '<tr><td style=\"padding:4px 12px;font-weight:bold;\">Model</td><td style=\"padding:4px 12px;\">' + model + '</td></tr>' \
               '<tr><td style=\"padding:4px 12px;font-weight:bold;\">Created</td><td style=\"padding:4px 12px;\">' + ts + '</td></tr>' \
               '</table>'
        msg = MIMEText(body, 'html')
        msg['Subject'] = '[Constructor Fabric] New instance: ' + domain
        msg['From'] = '$SMTP_USER'
        recipients = [r.strip() for r in '$RECIPIENTS'.split(',') if r.strip()]
        if not recipients:
            print('[notify] No recipients, skipping')
            sys.exit(0)
        msg['To'] = ', '.join(recipients)
        try:
            with smtplib.SMTP('$SMTP_HOST', int('$SMTP_PORT'), timeout=15) as s:
                s.starttls()
                s.login('$SMTP_USER', '$SMTP_PASS')
                s.sendmail('$SMTP_USER', recipients, msg.as_string())
            print('[notify] Sent to ' + ', '.join(recipients))
        except Exception as e:
            print('[notify] SMTP failed: ' + str(e))
        " || echo "[notify] Error — non-critical"


        # Welcome email to user with password. MUST NOT fail.
        CS_PASS="$(cat /home/developer/.code-server-password 2>/dev/null || echo '')"
        if [ -n "$CUSTOMER" ] && [ -n "$CS_PASS" ]; then
          python3 -c "
        import smtplib
        from email.mime.text import MIMEText
        domain = '$DOMAIN'
        password = '$CS_PASS'
        customer = '$CUSTOMER'
        body = '<h2>Your Constructor Fabric instance is ready</h2>' \\
               '<table style=\\"border-collapse:collapse;font-size:15px;\\">' \\
               '<tr><td style=\\"padding:4px 12px;font-weight:bold;\\">URL</td><td style=\\"padding:4px 12px;\\"><a href=\\"https://' + domain + '/\\">https://' + domain + '/</a></td></tr>' \\
               '<tr><td style=\\"padding:4px 12px;font-weight:bold;\\">Password</td><td style=\\"padding:4px 12px;font-family:monospace;font-size:18px;letter-spacing:1px;\\">' + password + '</td></tr>' \\
               '</table>' \\
               '<p style=\\"margin-top:16px;color:#555;\\">Open the URL above and enter the password to access your IDE.</p>'
        msg = MIMEText(body, 'html')
        msg['Subject'] = 'Your Constructor Fabric instance is ready'
        msg['From'] = '$SMTP_USER'
        msg['To'] = customer
        try:
            with smtplib.SMTP('$SMTP_HOST', int('$SMTP_PORT'), timeout=15) as s:
                s.starttls()
                s.login('$SMTP_USER', '$SMTP_PASS')
                s.sendmail('$SMTP_USER', [customer], msg.as_string())
            print('[notify] Welcome email sent to ' + customer)
        except Exception as e:
            print('[notify] Welcome email failed: ' + str(e))
        " || echo "[notify] Welcome email error — non-critical"
        fi
success: |
  ### Constructor Fabric is ready

  #### Access

  Open Constructor Fabric:
  [https://${env.domain}/](https://${env.domain}/)

  Password: check your email or run `cat ~/.code-server-password` on the server

  #### Workspace

  `/home/developer/workspaces/constructor-fabric-workspace`
