type: install
version: 0.4.42
id: constructor-fabric
baseUrl: https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/main/
name: Constructor Fabric
logo: assets/constructor-fabric-logo.png
categories:
  - apps/dev-and-admin-tools
  - apps/collaboration
  - apps/productivity

description:
  text: CLets AI define, build, and run software end to end -- with reusable components, operational automation, and built-in productivity measurement and insights.
  short: Constructor Fabric

targetRegions:
  type: vz7

ssl: true
skipNodeEmails: true

globals:
  VNC_PASSWORD: ${fn.password(16)}
  CF_PORT: 8081
  APP_PORT: 8081
  LLM_PROVIDER: openai
  OPENAI_MODEL: gpt-4o-mini
  CLAUDE_MODEL: claude-3-5-sonnet-latest
  RESOLUTION: 1280x720
  SCRIPT_VERSION: trainer-title-token-20260602-2
  CF_SOURCE_REF: 3983d4faa378ab7282d60d4d3452ca6b8b097279

settings:
  fields:
    - caption: LLM provider
      type: list
      inputType: string
      name: llm-provider
      default: openai
      values:
        openai: OpenAI
        claude: Claude
      tooltip: Select which LLM provider the Constructor Fabric workflow should use.
      showIf:
        openai:
          - caption: OpenAI model
            type: list
            inputType: string
            name: openai-model
            default: gpt-4o-mini
            values:
              gpt-4o-mini: OpenAI GPT-4o mini
              gpt-4o: OpenAI GPT-4o
              gpt-4.1-mini: OpenAI GPT-4.1 mini
              gpt-4.1: OpenAI GPT-4.1
            tooltip: Select the OpenAI model used by the Constructor Fabric workflow.
        claude:
          - caption: Anthropic model
            type: list
            inputType: string
            name: claude-model
            default: claude-3-5-sonnet-latest
            values:
              claude-3-5-sonnet-latest: Claude 3.5 Sonnet latest
              claude-3-7-sonnet-latest: Claude 3.7 Sonnet latest
              claude-sonnet-4-20250514: Claude Sonnet 4
              claude-opus-4-20250514: Claude Opus 4
            tooltip: Select the Anthropic Claude model used by the Constructor Fabric workflow.
    - caption: API Token
      type: string
      inputType: password
      name: api-token
      value: ""
      required: false
      tooltip: API token for the selected provider. Use an OpenAI key for openai or an Anthropic/Claude key for claude.

nodes:
  - image: ihorman/constructor-fabric:latest
    nodeType: docker
    displayName: Constructor Fabric
    cloudlets: 64
    nodeGroup: cp
    ports:
      - 80
      - 5900
    endpoints:
      - name: VNC
        privatePort: 5900
        protocol: TCP
    env:
      TZ: Europe/Kyiv
      USER: developer
      PASSWORD: ${globals.VNC_PASSWORD}
      VNC_PASSWORD: ${globals.VNC_PASSWORD}
      HTTP_PASSWORD: ${globals.VNC_PASSWORD}
      LLM_PROVIDER: ${settings.llm-provider}
      API_TOKEN: ${settings.api-token}
      OPENAI_API_KEY: ${settings.api-token}
      ANTHROPIC_API_KEY: ${settings.api-token}
      OPENAI_MODEL: ${settings.openai-model:gpt-4o-mini}
      CLAUDE_MODEL: ${settings.claude-model:claude-3-5-sonnet-latest}
      CF_IDE_PROFILE: all
      CF_PREINSTALLED_IDES: 1
      CF_HOME: /home/developer/constructor-fabric
      CF_PORT: ${globals.CF_PORT}
      ALSADEV: default
      PULSE_RUNTIME_PATH: /tmp/pulse-root
      PULSE_SERVER: unix:/tmp/pulse-root/native
      SDL_AUDIODRIVER: pulse
      AUDIODEV: default
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      JELASTIC_EXPOSE: 80
      JELASTIC_PORTS: 80
      RESOLUTION: 1280x720
      SCRIPT_VERSION: ${globals.SCRIPT_VERSION}
      CF_SOURCE_REF: ${globals.CF_SOURCE_REF}

onInstall:
  - bootstrap
  - verify

actions:
  bootstrap:
    - cmd[cp]: |-
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        # The currently published latest image can contain a stale Cursor apt source
        # and can be missing XKB files even when dpkg says xkb-data is installed.
        # Repair that root-level image state before the developer-only bootstrap starts.
        if [ ! -d /usr/share/X11/xkb/keycodes ] || [ ! -d /usr/share/X11/xkb/symbols ]; then
          find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -print0 | xargs -0 grep -l 'api.cursor.com/apt' 2>/dev/null | xargs -r rm -f
          apt-get update
          apt-get install -y --reinstall xkb-data || { apt-get purge -y xkb-data; apt-get update; apt-get install -y xkb-data; }
          rm -rf /var/lib/apt/lists/*
        fi
        if ! command -v electron >/dev/null 2>&1 && [ -x /opt/node-current/bin/npm ]; then
          /opt/node-current/bin/npm install -g electron@latest
          ln -sf /opt/node-current/bin/electron /usr/local/bin/electron 2>/dev/null || true
        fi
        if ! command -v xdotool >/dev/null 2>&1; then
          apt-get update
          apt-get install -y --no-install-recommends xdotool
          rm -rf /var/lib/apt/lists/*
        fi
        # The base VNC startup may leave /home/developer owned by root. Fix it
        # before downloading runtime scripts, then execute bootstrap as developer.
        chown -R developer:developer /home/developer
        curl --noproxy '*' -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/scripts/bootstrap.sh?v=${globals.SCRIPT_VERSION}" -o /tmp/constructor-fabric-bootstrap.sh
        chmod +x /tmp/constructor-fabric-bootstrap.sh
        chown developer:developer /tmp/constructor-fabric-bootstrap.sh
        su - developer -c "/tmp/constructor-fabric-bootstrap.sh"

        # Post-bootstrap AI chat setup is intentionally inline in the JPS
        # manifest so it does not require changing CF_SOURCE_REF. The trainer
        # updater owns CF_SOURCE_REF; this block only wires VS Codium to open
        # Continue chat with the token passed via JPS settings.
        mkdir -p /home/developer/.continue /home/developer/.config/VSCodium/User /home/developer/constructor-fabric /home/developer/workspaces/constructor-fabric-workspace/.vscode
        ai_token="$(printenv API_TOKEN || true)"
        ai_openai_key="$(printenv OPENAI_API_KEY || true)"
        ai_anthropic_key="$(printenv ANTHROPIC_API_KEY || true)"
        if [ -z "$ai_openai_key" ]; then ai_openai_key="$ai_token"; fi
        if [ -z "$ai_anthropic_key" ]; then ai_anthropic_key="$ai_token"; fi
        {
          printf '%s\n' "API_TOKEN=$ai_token"
          printf '%s\n' "OPENAI_API_KEY=$ai_openai_key"
          printf '%s\n' "ANTHROPIC_API_KEY=$ai_anthropic_key"
        } >/home/developer/.constructor-fabric-ai.env
        chmod 600 /home/developer/.constructor-fabric-ai.env
        continue_provider="$(printenv LLM_PROVIDER || true)"
        if [ -z "$continue_provider" ]; then continue_provider="openai"; fi
        continue_model="$(printenv OPENAI_MODEL || true)"
        if [ -z "$continue_model" ]; then continue_model="gpt-4o-mini"; fi
        if [ "$continue_provider" = "anthropic" ]; then
          continue_model="$(printenv CLAUDE_MODEL || true)"
          if [ -z "$continue_model" ]; then continue_model="claude-3-5-sonnet-latest"; fi
        fi
        cat >/home/developer/.continue/config.yaml <<CONTINUECFG
        name: Constructor Fabric
        version: 1.0.0
        schema: v1
        env:
          OPENAI_API_KEY: ${ai_openai_key}
          ANTHROPIC_API_KEY: ${ai_anthropic_key}
          API_TOKEN: ${ai_token}
        models:
          - name: Constructor Fabric Chat
            provider: ${continue_provider}
            model: ${continue_model}
        CONTINUECFG
        if [ -n "${API_TOKEN:-}" ]; then
          printf "    apiKey: %s\n" "${API_TOKEN}" >> /home/developer/.continue/config.yaml
        fi
        cat >>/home/developer/.continue/config.yaml <<CONTINUECFG
            roles:
              - chat
              - edit
              - apply
              - autocomplete
        context:
          - provider: code
          - provider: docs
        CONTINUECFG
        cat >/home/developer/.config/VSCodium/User/settings.json <<VSCODESETTINGS
        {
          "workbench.startupEditor": "none",
          "security.workspace.trust.enabled": false,
          "security.workspace.trust.startupPrompt": "never",
          "continue.telemetryEnabled": false,
          "continue.showInlineTip": false
        }
        VSCODESETTINGS
        cat >/home/developer/workspaces/constructor-fabric-workspace/.vscode/cfc-commands.md <<CFCMDS
        View: Show Continue
        Focus Continue Chat
        CFCMDS
        cat >/home/developer/constructor-fabric/open-vscodium-chat.sh <<'OPENCHAT'
        #!/bin/sh
        set -u
        case "${HOME:-}" in
          ""|-*) HOME=/home/developer ;;
        esac
        export HOME
        if [ -f "${HOME}/.constructor-fabric-ai.env" ]; then
          set -a
          . "${HOME}/.constructor-fabric-ai.env"
          set +a
        fi
        export PATH="${HOME}/.local/bin:/opt/node-current/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
        workspace="${HOME}/workspaces/constructor-fabric-workspace"
        mkdir -p "$workspace/.vscode"
        cd "$workspace" || exit 0
        launcher=codium-wrap
        if ! command -v "$launcher" >/dev/null 2>&1; then
          launcher=codium
        fi
        "$launcher" --user-data-dir="${HOME}/.config/VSCodium" --reuse-window --goto .vscode/cfc-commands.md . &
        codium_pid=$!
        if command -v xdotool >/dev/null 2>&1; then
          for i in $(seq 1 40); do
            win="$(xdotool search --onlyvisible --class codium 2>/dev/null | tail -1 || true)"
            if [ -n "$win" ]; then
              xdotool windowactivate --sync "$win" 2>/dev/null || xdotool windowactivate "$win" 2>/dev/null || true
              sleep 1
              xdotool key --window "$win" ctrl+shift+p 2>/dev/null || true
              sleep 1
              xdotool type --window "$win" --delay 5 "View: Show Continue" 2>/dev/null || true
              sleep 1
              xdotool key --window "$win" Return 2>/dev/null || true
              sleep 4
              xdotool key --window "$win" ctrl+shift+p 2>/dev/null || true
              sleep 1
              xdotool type --window "$win" --delay 5 "Focus Continue Chat" 2>/dev/null || true
              sleep 1
              xdotool key --window "$win" Return 2>/dev/null || true
              break
            fi
            sleep 1
          done
        fi
        wait "$codium_pid"
        OPENCHAT
        chmod +x /home/developer/constructor-fabric/open-vscodium-chat.sh
        if [ -f /home/developer/Desktop/VS-Codium.desktop ]; then
          sed -i "s|^Exec=.*|Exec=/home/developer/constructor-fabric/open-vscodium-chat.sh|" /home/developer/Desktop/VS-Codium.desktop
        else
          cat >/home/developer/Desktop/VS-Codium.desktop <<VSCODIUMDESK
        [Desktop Entry]
        Version=1.0
        Type=Application
        Name=VS Codium
        Exec=/home/developer/constructor-fabric/open-vscodium-chat.sh
        Icon=/home/developer/constructor-fabric/app/icons/codium.png
        Terminal=false
        Categories=Development;
        StartupNotify=true
        VSCODIUMDESK
        fi
        chmod +x /home/developer/Desktop/VS-Codium.desktop
        chown -R developer:developer /home/developer/.constructor-fabric-ai.env /home/developer/.continue /home/developer/.config/VSCodium /home/developer/constructor-fabric/open-vscodium-chat.sh /home/developer/workspaces /home/developer/Desktop/VS-Codium.desktop
        su - developer -c "export HOME=/home/developer PATH=/home/developer/.local/bin:/opt/node-current/bin:/usr/local/bin:/usr/bin:/bin; if command -v codium >/dev/null 2>&1; then codium --install-extension Continue.continue --force >/tmp/continue-install.log 2>&1 || true; fi"

  verify:
    - cmd[cp]: |-
        set -euo pipefail
        export NO_PROXY=localhost,127.0.0.1,::1
        export no_proxy=$NO_PROXY
        app_ready=0
        for i in $(seq 1 60); do
          if curl --noproxy "*" -fsS http://127.0.0.1:8081/health >/dev/null; then
            echo "Constructor Fabric app is up"
            curl --noproxy "*" -fsS http://127.0.0.1:8081/health
            app_ready=1
            break
          fi
          sleep 2
        done
        if [ "$app_ready" != "1" ]; then
          echo "Constructor Fabric app did not become ready in time" >&2
          exit 1
        fi
        check_port() {
          host="$1"; port="$2"; name="$3"; want_rfb="$4"
          if [ -z "$want_rfb" ]; then want_rfb=0; fi
          for i in $(seq 1 30); do
            if python3 - "$host" "$port" "$want_rfb" <<PYPORT
        import socket, sys
        host=sys.argv[1]; port=int(sys.argv[2]); want_rfb=sys.argv[3] == "1"
        s=socket.create_connection((host, port), timeout=2)
        if want_rfb:
            banner=s.recv(12).decode(errors="replace").strip()
            assert banner.startswith("RFB"), banner
        s.close()
        PYPORT
            then
              echo "$name is up on $host:$port"
              return 0
            fi
            sleep 2
          done
          echo "$name did not become ready" >&2
          echo "process list:" >&2
          ps aux | grep -E "Xvfb|x11vnc|websockify|supervisord" | grep -v grep >&2 || true
          echo "x11vnc.log:" >&2
          tail -120 /home/developer/constructor-fabric/x11vnc.log >&2 2>/dev/null || true
          echo "xvfb.log:" >&2
          tail -80 /home/developer/constructor-fabric/xvfb.log >&2 2>/dev/null || true
          return 1
        }
        check_port 127.0.0.1 5900 native-vnc 1
        check_port 127.0.0.1 6081 websockify 0
        cat >/tmp/constructor-fabric-verify-developer.sh <<VERIFYDEV
        set -euo pipefail
        test -f /home/developer/Desktop/Chromium.desktop || { echo "Chromium desktop launcher missing" >&2; exit 1; }
        grep -q "^Name=Chromium$" /home/developer/Desktop/Chromium.desktop || { echo "Chromium desktop launcher has wrong label" >&2; exit 1; }
        grep -Eq "^Exec=(/usr/local/bin/)?constructor-fabric-chromium" /home/developer/Desktop/Chromium.desktop || { echo "Chromium desktop launcher has wrong Exec" >&2; exit 1; }
        command -v constructor-fabric-chromium >/dev/null 2>&1 || { echo "Chromium wrapper missing" >&2; exit 1; }
        test -f /home/developer/Desktop/Terminal.desktop || { echo "Terminal desktop launcher missing" >&2; exit 1; }
        test -f /home/developer/Desktop/Constructor-Fabric-Trainer.desktop || { echo "Constructor desktop launcher missing" >&2; exit 1; }
        grep -q "^Name=Constructor Fabric Trainer$" /home/developer/Desktop/Constructor-Fabric-Trainer.desktop || { echo "Constructor desktop launcher has wrong label" >&2; exit 1; }
        grep -q "run-trainer.sh" /home/developer/Desktop/Constructor-Fabric-Trainer.desktop || { echo "Constructor desktop launcher has wrong Exec" >&2; exit 1; }
        test -f /home/developer/Desktop/VS-Codium.desktop || { echo "VS Codium desktop launcher missing" >&2; exit 1; }
        grep -q "open-vscodium-chat.sh" /home/developer/Desktop/VS-Codium.desktop || { echo "VS Codium desktop launcher does not open AI chat wrapper" >&2; exit 1; }
        test -f /home/developer/constructor-fabric/open-vscodium-chat.sh || { echo "VS Codium AI chat wrapper missing" >&2; exit 1; }
        command -v xdotool >/dev/null 2>&1 || { echo "xdotool missing for Codium chat focus" >&2; exit 1; }
        test -f /home/developer/.continue/config.yaml || { echo "Continue config missing" >&2; exit 1; }
        grep -q "provider: " /home/developer/.continue/config.yaml || { echo "Continue provider missing" >&2; exit 1; }
        grep -q "model: " /home/developer/.continue/config.yaml || { echo "Continue model missing" >&2; exit 1; }
        if command -v firefox >/dev/null 2>&1 || command -v firefox-esr >/dev/null 2>&1; then echo "Firefox is still installed" >&2; exit 1; fi
        echo "Chromium, Terminal, Constructor, and VS Codium AI chat desktop launchers are present and Firefox is absent"
        cd /home/developer/cyber-constructor
        cfc --version
        cfc info --json >/tmp/cfc-info.json
        cfc validate --json >/tmp/cfc-validate.json
        cfc agents --json >/tmp/cfc-agents.json
        python3 <<PYCHECK
        import json
        info=json.load(open("/tmp/cfc-info.json"))
        assert info["status"] == "FOUND", info
        assert info["relative_path"] == ".cf-constructor", info
        validate=json.load(open("/tmp/cfc-validate.json"))
        assert validate["status"] == "PASS", validate
        agents=json.load(open("/tmp/cfc-agents.json"))
        assert agents["status"] == "OK", agents
        text=json.dumps(agents).lower()
        required=["windsurf","cursor","claude","copilot","openai"]
        missing=[x for x in required if x not in text]
        assert not missing, {"missing": missing, "data": agents}
        print("cyber-constructor info is FOUND at .cf-constructor")
        print("cyber-constructor validate is PASS")
        print("cyber-constructor agents are OK for " + ", ".join(required))
        PYCHECK
        VERIFYDEV
        chmod +x /tmp/constructor-fabric-verify-developer.sh
        chown developer:developer /tmp/constructor-fabric-verify-developer.sh
        su - developer -c /tmp/constructor-fabric-verify-developer.sh
success: |
  ### Constructor Fabric is ready

  #### Access

  [Open Constructor Fabric noVNC desktop](https://${env.domain}/)

  #### VNC password

  Use this password if noVNC asks for it:

  `${globals.VNC_PASSWORD}`

  #### Desktop contents

  - noVNC opens the Constructor Fabric desktop at 1280x720.
  - The bottom LXDE panel contains launchers, clock, tray, and task switcher.
  - The Constructor Fabric Trainer opens as an Electron desktop app with copy-ready prompts.
  - The desktop is intentionally minimal: Trainer, Chromium, Terminal Emulator, VS Codium, Cursor, and Windsurf only.
  - Firefox is removed; the Chromium launcher runs the container-safe browser directly.
  - Claude/Codex integrations are generated inside the workspace for those IDEs; no misleading terminal-only IDE icons are shown.

  #### Workspace

  `/home/developer/workspaces/constructor-fabric-workspace`

  #### Install options used

  | Setting | Value |
  |---------|-------|
  | LLM provider | `${settings.llm-provider}` |
  | Model | `${settings.openai-model:}${settings.claude-model:}` |
  | API Token | configured from install form when provided |

  If you set an API Token in the install form, Constructor Fabric exports it into the generated workspace environment.

