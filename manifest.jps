type: install
version: 0.5.0
id: constructor-fabric
baseUrl: https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/main/
name: Constructor Fabric
logo: assets/constructor-fabric-logo.png
categories:
  - apps/dev-and-admin-tools
  - apps/collaboration
  - apps/productivity

description:
  text: Lets AI define, build, and run software end to end with a plain browser code-server workspace and built-in trainer.
  short: Constructor Fabric

ssl: true
skipNodeEmails: true

globals:
  LLM_PROVIDER: openai
  OPENAI_MODEL: gpt-5.5
  CLAUDE_MODEL: claude-sonnet-4-6
  SCRIPT_VERSION: code-server-only-20260608-8
  CF_SOURCE_REF: main

settings:
  fields:
    - caption: LLM provider
      type: list
      inputType: string
      name: llm-provider
      default: openai
      values:
        openai: OpenAI
        claude: Claude
      tooltip: Select which LLM provider the Constructor Fabric workflow should use.
      showIf:
        openai:
          - caption: OpenAI model
            type: list
            inputType: string
            name: openai-model
            default: gpt-5.5
            values:
              gpt-5.5: OpenAI GPT-5.5
              gpt-5.4: OpenAI GPT-5.4
            tooltip: Select the OpenAI model used by the Constructor Fabric workflow.
        claude:
          - caption: Anthropic model
            type: list
            inputType: string
            name: claude-model
            default: claude-sonnet-4-6
            values:
              claude-sonnet-4-6: Claude Sonnet 4.6
              claude-opus-4-8: Claude Opus 4.8
              claude-haiku-4-5: Claude Haiku 4.5
            tooltip: Select the Anthropic Claude model used by the Constructor Fabric workflow.
    - caption: API Token
      type: string
      inputType: password
      name: api-token
      value: ""
      required: false
      tooltip: API token for the selected provider. Use an OpenAI key for openai or an Anthropic/Claude key for claude.

nodes:
  - image: ihorman/constructor-fabric:20260608
    nodeType: docker
    displayName: Constructor Fabric
    cloudlets: 64
    nodeGroup: cp
    extIPs: 1
    ports:
      - 8080
    endpoints:
      - name: Constructor Fabric
        privatePort: 8080
        protocol: TCP
    env:
      TZ: Europe/Kyiv
      USER: developer
      HOME: /home/developer
      LLM_PROVIDER: ${settings.llm-provider}
      API_TOKEN: ${settings.api-token}
      OPENAI_API_KEY: ${settings.api-token}
      ANTHROPIC_API_KEY: ${settings.api-token}
      OPENAI_MODEL: ${settings.openai-model}
      CLAUDE_MODEL: ${settings.claude-model:claude-sonnet-4-6}
      CF_HOME: /home/developer/constructor-fabric
      CF_WORKSPACE: /home/developer/workspaces/constructor-fabric-workspace
      NO_PROXY: localhost,127.0.0.1,::1
      no_proxy: localhost,127.0.0.1,::1
      JELASTIC_EXPOSE: 8080
      JELASTIC_PORTS: 8080
      SCRIPT_VERSION: ${globals.SCRIPT_VERSION}
      CF_SOURCE_REF: ${globals.CF_SOURCE_REF}

onInstall:
  - bootstrap
  - verify

actions:
  bootstrap:
    - cmd[cp]: |-
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive
        export HOME=/home/developer
        export USER=developer
        export PATH=/opt/node-current/bin:/home/developer/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH

        if ! id developer >/dev/null 2>&1; then
          useradd -m -u 1000 -s /bin/bash developer
        fi
        install -d -m 0755 /etc/sudoers.d
        printf '%s\n' 'developer ALL=(ALL) NOPASSWD:ALL' >/etc/sudoers.d/developer
        chmod 0440 /etc/sudoers.d/developer


        if ! command -v code-server >/dev/null 2>&1; then
          echo "Installing code-server..."
          CODE_SERVER_VERSION=4.104.2
          curl --noproxy '*' -fsSL "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server-${CODE_SERVER_VERSION}-linux-amd64.tar.gz" -o /tmp/code-server.tar.gz
          tar -xzf /tmp/code-server.tar.gz --strip-components=1 -C /usr/local
          rm -f /tmp/code-server.tar.gz
          code-server --version
        fi

        mkdir -p /home/developer/constructor-fabric /home/developer/workspaces/constructor-fabric-workspace
        chown -R developer:developer /home/developer

        umask 077
        cat >/home/developer/.constructor-fabric-ai.env <<ENV
        LLM_PROVIDER=${settings.llm-provider}
        API_TOKEN=${settings.api-token}
        OPENAI_API_KEY=${settings.api-token}
        ANTHROPIC_API_KEY=${settings.api-token}
        OPENAI_MODEL=${settings.openai-model}
        CLAUDE_MODEL=${settings.claude-model:claude-sonnet-4-6}
        ENV
        chmod 600 /home/developer/.constructor-fabric-ai.env
        chown developer:developer /home/developer/.constructor-fabric-ai.env

        curl --noproxy '*' -fsSL "https://raw.githubusercontent.com/jelastic-jps/constructor-fabric/${globals.CF_SOURCE_REF}/scripts/bootstrap.sh?v=${globals.SCRIPT_VERSION}" -o /tmp/constructor-fabric-bootstrap.sh
        chmod +x /tmp/constructor-fabric-bootstrap.sh
        chown developer:developer /tmp/constructor-fabric-bootstrap.sh
        su developer -c "/tmp/constructor-fabric-bootstrap.sh"

  verify:
    - cmd[cp]: |-
        set -euo pipefail
        export NO_PROXY=localhost,127.0.0.1,::1
        export no_proxy=$NO_PROXY

        ide_ready=0
        for i in $(seq 1 60); do
          if curl --noproxy "*" -fsS http://127.0.0.1:8080/ >/dev/null 2>&1; then
            echo "plain code-server is up on port 8080"
            ide_ready=1
            break
          fi
          sleep 2
        done
        if [ "$ide_ready" != "1" ]; then
          echo "code-server did not start on port 8080" >&2
          tail -80 /home/developer/constructor-fabric/code-server.log >&2 2>/dev/null || true
          exit 1
        fi

        python3 - <<'PYCHECK'
        import json
        from pathlib import Path
        ext = Path('/home/developer/.local/share/code-server/extensions/constructor-fabric-trainer')
        assert (ext / 'package.json').exists(), ext
        assert (ext / 'extension.js').exists(), ext
        pkg = json.loads((ext / 'package.json').read_text())
        assert 'onStartupFinished' in pkg.get('activationEvents', []), pkg
        settings = Path('/home/developer/.local/share/code-server/User/settings.json')
        assert settings.exists(), settings
        data = json.loads(settings.read_text())
        assert data.get('workbench.colorTheme') == 'Default Dark Modern'
        assert data.get('workbench.startupEditor') == 'none'
        assert data.get('window.restoreWindows') == 'none'
        terminal_env = data.get('terminal.integrated.env.linux', {})
        assert terminal_env.get('LLM_PROVIDER') in ('openai', 'claude'), terminal_env
        extensions = Path('/home/developer/.local/share/code-server/extensions')
        names = {p.name.lower() for p in extensions.iterdir() if p.is_dir()} if extensions.exists() else set()
        assert not any(name.startswith('github.copilot') or 'copilot-chat' in name for name in names), names
        trainer = Path('/home/developer/workspaces/constructor-fabric-workspace/.constructor-fabric-trainer/index.html')
        assert trainer.exists() and trainer.stat().st_size > 100, trainer
        assert Path('/home/developer/.constructor-fabric-ai.env').exists()
        print('code-server trainer webview extension, provider env, and dark theme are configured')
        PYCHECK

        cd /home/developer/cyber-constructor
        cfc --version
        cfc info --json >/tmp/cfc-info.json
        cfc validate --json >/tmp/cfc-validate.json
        python3 <<'PYCHECK'
        import json
        info=json.load(open('/tmp/cfc-info.json'))
        assert info['status'] == 'FOUND', info
        validate=json.load(open('/tmp/cfc-validate.json'))
        assert validate['status'] == 'PASS', validate
        print('cyber-constructor info is FOUND')
        print('cyber-constructor validate is PASS')
        PYCHECK

        echo "=== All checks passed ==="

success: |
  <h3>Constructor Fabric is ready</h3>

  <h4>ACCESS</h4>
  <p>
    Open Constructor Fabric:<br>
    <a href="https://${env.domain}/" target="_blank">https://${env.domain}/</a>
  </p>

  <h4>WHAT YOU WILL SEE</h4>
  <p>
    The environment runs plain coder code-server directly on port 8080. The Constructor Fabric trainer opens inside code-server through a local startup Webview extension.
  </p>
  <p>
    Only code-server is started for the web interface. There is no nginx proxy, no separate trainer HTTP service, and no desktop sidecar.
  </p>

  <h4>WORKSPACE</h4>
  <p><code>/home/developer/workspaces/constructor-fabric-workspace</code></p>

  <h4>INSTALL OPTIONS USED</h4>
  <table>
    <tr><td>LLM provider</td><td><code>${settings.llm-provider}</code></td></tr>
    <tr><td>Model</td><td><code>${settings.openai-model:}${settings.claude-model:}</code></td></tr>
    <tr><td>API Token</td><td>configured from install form when provided</td></tr>
  </table>
